{
  "version": "2.21",
  "children": [
    {
      "id": "card",
      "type": "frame",
      "name": "Card",
      "x": 40,
      "y": 40,
      "width": 360,
      "layout": "vertical",
      "gap": 12,
      "padding": [20, 24],
      "justifyContent": "start",
      "alignItems": "center",
      "cornerRadius": [16, 16, 4, 4],
      "clip": true,
      "opacity": 0.9,
      "fill": [
        "#FFFFFF",
        { "type": "gradient", "gradientType": "linear", "rotation": 180, "colors": [{ "color": "#FF000000", "position": 0 }, { "color": "#FF0000FF", "position": 1 }] }
      ],
      "stroke": "#CCCCCC",
      "strokeWidth": { "bottom": 2 },
      "strokeAlignment": "inner",
      "effect": [
        { "type": "shadow", "shadowType": "outer", "offset": { "x": 0, "y": 4 }, "blur": 12, "color": "#00000033" },
        { "type": "shadow", "shadowType": "inner", "offset": { "x": 1, "y": 1 }, "blur": 2, "color": "#FFFFFF80" },
        { "type": "blur", "radius": 0 }
      ],
      "children": [
        { "id": "title", "type": "text", "content": "Hello, Pencil", "fontFamily": "Inter", "fontSize": 24, "fontWeight": "700", "fill": "#111111" },
        {
          "id": "body",
          "type": "text",
          "content": "A paragraph that is long enough to wrap onto several lines when it is given a fixed width.",
          "fontSize": 14,
          "lineHeight": 1.5,
          "textAlign": "center",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "fill": "#444444"
        },
        { "id": "dot", "type": "ellipse", "width": 40, "height": 40, "fill": "#22C55E", "stroke": { "align": "outside", "thickness": 3, "fill": "#166534" } },
        { "id": "arc", "type": "ellipse", "width": 40, "height": 40, "fill": "#3B82F6", "innerRadius": 0.5, "startAngle": 0, "sweepAngle": 90 },
        { "id": "hex", "type": "polygon", "width": 48, "height": 48, "polygonCount": 6, "fill": "#F59E0B", "rotation": 30 },
        {
          "id": "check",
          "type": "path",
          "geometry": "M2 12l6 6L20 6",
          "viewBox": [0, 0, 24, 24],
          "width": 48,
          "height": 48,
          "stroke": "#16A34A",
          "strokeWidth": 3,
          "strokeLinecap": "round",
          "strokeLinejoin": "round"
        },
        {
          "id": "row",
          "type": "frame",
          "width": "fill_container",
          "justifyContent": "space_between",
          "children": [
            { "id": "a", "type": "rectangle", "width": 60, "height": 30, "fill": "#E5E7EB", "cornerRadius": 8 },
            { "id": "b", "type": "rectangle", "width": 60, "height": 30, "fill": "#D1D5DB", "cornerRadius": 8, "enabled": false },
            { "id": "c", "type": "rectangle", "width": 60, "height": 30, "fill": "#9CA3AF", "cornerRadius": 8 }
          ]
        },
        {
          "id": "pinned",
          "type": "rectangle",
          "layoutPosition": "absolute",
          "x": 300,
          "y": 8,
          "width": 24,
          "height": 24,
          "fill": "#EF4444"
        }
      ]
    },
    {
      "id": "group",
      "type": "group",
      "x": 500,
      "y": 60,
      "children": [
        { "id": "g1", "type": "rectangle", "x": 10, "y": 20, "width": 100, "height": 50, "fill": "#8B5CF6" },
        { "id": "g2", "type": "ellipse", "x": 60, "y": 50, "width": 80, "height": 80, "fill": "#EC4899" }
      ]
    },
    { "id": "radial", "type": "rectangle", "x": 500, "y": 240, "width": 160, "height": 100, "fill": { "type": "gradient", "gradientType": "radial", "colors": [{ "color": "#FFFFFF", "position": 0 }, { "color": "#1E3A8A", "position": 1 }] } },
    { "id": "mirrored", "type": "rectangle", "x": 700, "y": 240, "width": 100, "height": 60, "flipX": true, "rotation": 15, "fill": "#14B8A6" },
    { "id": "script", "type": "script", "x": 0, "y": 600, "width": 100, "height": 100, "scriptUri": "./grid.js" },
    { "id": "mystery", "type": "hologram", "x": 0, "y": 700, "width": 10, "height": 10 }
  ]
}
